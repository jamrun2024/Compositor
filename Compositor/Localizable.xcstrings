    },
    "How far apart the screen's lines are" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕扫描线的间距"
          }
        }
      }
    },
    "How far each color channel (0–255) can differ from the clicked color and still be selected" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个颜色通道 (0–255) 与所点颜色相差多少仍会被选中"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锐化从每条边缘向外延伸的距离，单位为像素。"
          }
        }
      }
    },
    "How far in brightness the adjustment reaches." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整在亮度上覆盖的范围。"
          }
        }
      }
    },
    "How far in hue the adjustment reaches." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整在色相上覆盖的范围。"
          }
        }
      }
    },
    "How far in saturation the adjustment reaches." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整在饱和度上覆盖的范围。"
          }
        }
      }
    },
    "How far the blur softens, in pixels" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊柔化的范围，单位为像素"
          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个像素的误差扩散到相邻像素的程度。越少，色块越平"
          }
        }
      }
    },
    "How much of the profile distortion correction is applied." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用多少配置文件的扭曲校正。"
          }
        }
      }
    },
    "How much of the profile vignetting correction is applied." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用多少配置文件的晕影校正。"
          }
        }
      }
    },
    "How much the curve also changes color strength. Zero matches Photoshop; lower keeps it to brightness, higher adds more color." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲线同时改变颜色浓度的程度。0 与 Photoshop 一致；更低只影响亮度，更高会增加更多颜色。"
          }
        }
      }
    },
